# ============================================================
# CopySnipIn - Zero-Execution Copytrading Workbench Configuration
# ============================================================
# Copy this file to .env for local use if needed.
# NEVER commit .env or real secret values to version control.

# -- Active Runtime Variables --------------------------------

# Core stores
DATABASE_URL=postgresql://localhost:5432/copysnipin
REDIS_URL=redis://localhost:6379/0

# API / dashboard
API_PORT=8090
DASHBOARD_REFRESH_SECS=30

# Hermes scanner thresholds
SCAN_INTERVAL_SECS=600
MIN_SHARPE_RATIO=2.0
MAX_DRAWDOWN_PCT=10.0
MIN_TRADES=20
MIN_VOLUME_USD=10000

# Read-only Polymarket HTTP endpoints
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com

# Read-only/paper-trading configuration
PYTH_ASSETS=
SIMULATION_SEED_USD=10000

# Optional non-blocking alerts
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=

# -- Disabled / Future-Scope Variables -----------------------
# These placeholders are documented for future phases only. They are not loaded
# by ActiveSettings and must not become startup requirements in v1.

POLYMARKET_WS_URL=
PYTH_TOKEN=
SOLANA_PRIVATE_KEY=
HELIUS_API_KEY=
HELIUS_RPC_URL=
SOLANA_RPC_URL=
LASERSTREAM_URL=
LASERSTREAM_API_KEY=
JITO_BLOCK_ENGINE_URL=
JITO_TIP_LAMPORTS=
LIVE_FUNDED_VALIDATION=false
